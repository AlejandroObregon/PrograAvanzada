@model IEnumerable<Pedidos.Abstracciones.ModelosParaUI.ClienteDto>
@{
    ViewBag.Title = "Seleccionar Cliente para Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row tm-content-row tm-mt-big">
    <div class="col-12">
        <div class="bg-white tm-block">
            <div class="row">
                <div class="col-md-8 col-sm-12">
                    <h2 class="tm-block-title">Seleccionar Cliente para Nuevo Pedido</h2>
                </div>
                <div class="col-md-4 col-sm-12 text-right">
                    <a href="@Url.Action("ListarCliente", "Cliente")" class="btn btn-info">
                        <i class="fas fa-users me-1"></i>Gestionar Clientes
                    </a>
                </div>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-hover table-striped" id="clientesPedidoTable">
                    <thead>
                        <tr class="tm-bg-gray">
                            <th>ID</th>
                            <th>Nombre del Cliente</th>
                            <th>Cédula</th>
                            <th>Correo</th>
                            <th>Dirección</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold">@item.Nombre</td>
                                <td>@item.Cedula</td>
                                <td>@item.Correo</td>
                                <td>@item.Direccion</td>
                                <td class="text-center">
                                    <a href="@Url.Action("CrearPedido", new { clienteId = item.Id })" class="btn btn-success btn-sm">
                                        <i class="fas fa-cart-plus me-1"></i>Crear Pedido
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Seleccione un cliente para crear un nuevo pedido. Si el cliente no existe, puede crearlo desde la gestión de clientes.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#clientesPedidoTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                },
                "pageLength": 10,
                "responsive": true,
                "order": [[1, "asc"]]
            });
        });
    </script>
}